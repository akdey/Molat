# =====================================================================
# Molat Frontend Environment Configuration
# =====================================================================

# Backend API URL:
# - In local development: Leave empty to automatically use Vite dev server's proxy (http://localhost:7860).
# - In production (Vercel): Set to your Hugging Face Space URL, e.g.:
#   https://a-k-dey-molat.hf.space
VITE_API_URL=https://a-k-dey-molat.hf.space

# Default X-Library-Key for write operations (adding/editing books, logging sessions, acquiring wishlist).
# Can also be entered interactively in the app via the Key Settings icon.
VITE_LIBRARY_KEY=development-secret-key-change-in-production

