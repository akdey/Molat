# Server
PORT=7860
HOST=0.0.0.0
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://molat.vercel.app

# Security & Authorization
# When configured, mutation requests (POST/PATCH/DELETE) require header: X-Library-Key: <LIBRARY_KEY>
LIBRARY_KEY=

# Google Sheets Bridge Configuration
# Apps Script Web App Deployment URL
GOOGLE_SHEETS_BRIDGE_URL=
# Secret token configured in Apps Script Script Properties as BRIDGE_TOKEN
BRIDGE_TOKEN=

# Cache TTL in seconds (default 300)
CACHE_TTL_SECONDS=300
TIMEZONE=Asia/Kolkata
