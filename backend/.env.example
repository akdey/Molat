# =====================================================================
# Molat Personal Book Library - Backend Environment Variables
# =====================================================================

# Server Port
PORT=7860
DEBUG=False

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,https://molat.vercel.app

# Security & Multi-User Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-secure-password
JWT_SECRET=generate-a-random-secret-for-signing-tokens

# Relational Database (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
