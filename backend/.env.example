# =====================================================================
# Molat Personal Book Library - Backend Environment Variables
# =====================================================================

# Server Port
PORT=7860
DEBUG=False

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,https://molat.vercel.app

# Owner Authentication (Stored safely in backend environment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-secure-password
JWT_SECRET=generate-a-random-secret-for-signing-tokens

# Optional legacy key fallback
LIBRARY_KEY=

# Google Sheets Apps Script Web App Bridge
GOOGLE_SHEETS_BRIDGE_URL=https://script.google.com/macros/s/AKfycb.../exec
BRIDGE_TOKEN=your-random-uuid-bridge-token
