# Molat API Configuration

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Authentication (Single-owner access)
# When set, all mutation and private endpoints require Bearer auth or session header
OWNER_AUTH_TOKEN=
# Optional password hash for UI authentication
OWNER_PASSWORD_HASH=

# Google Sheets Configuration
# Google Spreadsheet ID (from spreadsheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
SPREADSHEET_ID=
# Path to Google Service Account JSON file (recommended in production)
GOOGLE_APPLICATION_CREDENTIALS=
# OR the raw JSON string content of the service account key
GOOGLE_SERVICE_ACCOUNT_JSON=
# The sheet tab name (defaults to "Books")
SHEET_NAME=Books

# App Preferences
DEFAULT_CURRENCY=INR
REQUEST_TIMEOUT_SECONDS=15

